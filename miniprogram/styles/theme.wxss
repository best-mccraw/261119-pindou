page{--bg-pink:#FCE5E8;--bg-cream:#FFF1DC;--cherry:#F9D6DF;--surface:#FFFAF8;--soft:#FFF0F2;--brand:#F58FA7;--button-light:#F9B6C8;--rose:#D96883;--selected:#F17999;--ink:#751C35;--body:#8D5161;--muted:#B58A94;--line:#F8D8DF;--radius:48rpx;--shadow:0 16rpx 48rpx rgba(185,112,130,.10);background:linear-gradient(135deg,var(--bg-pink) 0%,var(--bg-cream) 100%);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:30rpx;line-height:1.55;min-height:100%}
view,input,button{box-sizing:border-box}button::after{border:0}button{font-family:inherit}button[disabled]{opacity:.58}.page{padding:32rpx 26rpx calc(48rpx + env(safe-area-inset-bottom))}.title{font-size:48rpx;font-weight:700;margin-bottom:10rpx}.sub,.hint{font-size:26rpx;color:var(--body)}.fine{font-size:24rpx;color:var(--body);margin-top:18rpx}.section{margin-top:30rpx}.label{font-size:38rpx;font-weight:700;margin-bottom:14rpx}.row{display:flex;align-items:center;gap:16rpx}.wrap{flex-wrap:wrap}.primary,.ui-button{width:100%;min-height:96rpx;border-radius:56rpx;background:linear-gradient(90deg,var(--button-light),var(--brand));color:var(--ink);font-size:36rpx;font-weight:600;line-height:1.4;padding:24rpx 28rpx;box-shadow:0 12rpx 28rpx rgba(217,104,131,.15);margin-top:24rpx;border:2rpx solid rgba(255,255,255,.8)}.secondary,.ui-button.secondary{min-height:88rpx;background:var(--surface);color:var(--ink);font-size:30rpx;border-radius:48rpx;padding:22rpx;margin-top:20rpx;border:2rpx solid var(--line)}.ui-button{margin-top:0}.ui-button.secondary{margin-top:0}.button-hover{filter:brightness(.97)}.ui-card,.surface{background:var(--surface);border:2rpx solid rgba(255,255,255,.85);border-radius:var(--radius);box-shadow:var(--shadow);padding:32rpx 28rpx}.chip,.ui-choice{padding:16rpx 24rpx;background:var(--soft);border:2rpx solid var(--line);border-radius:48rpx;color:var(--ink);font-size:28rpx;white-space:nowrap;min-height:80rpx}.ui-choice{width:100%;font-size:34rpx;font-weight:600;margin:0;line-height:1.5}.active,.ui-choice.active{border-color:var(--selected);background:var(--cherry)}.field,.ui-input{height:88rpx;min-width:0;width:100%;background:var(--surface);border:2rpx solid var(--line);border-radius:24rpx;padding:12rpx 16rpx;flex:1;color:var(--ink);font-size:30rpx}.ui-input.focus{border-color:var(--brand)}.input-placeholder{color:var(--muted)}.notice{padding:24rpx;background:var(--soft);border:1rpx solid var(--line);border-radius:24rpx;margin-top:24rpx;font-size:24rpx;color:var(--body)}.status{text-align:center;padding:32rpx 12rpx;color:var(--body);font-size:26rpx}.error{color:var(--rose)}.grid{display:flex;flex-wrap:wrap;gap:20rpx}.card{width:calc((100% - 20rpx)/2);background:var(--surface);border:2rpx solid white;border-radius:32rpx;overflow:hidden;box-shadow:var(--shadow)}.card image{width:100%;height:290rpx;display:block}.cardbody{padding:18rpx}.name{font-weight:600}.swatch{width:36rpx;height:36rpx;border:1px solid var(--line);border-radius:8rpx;display:inline-block;vertical-align:middle;margin-right:12rpx}.count{padding:14rpx 0;border-bottom:1px solid var(--line);font-size:28rpx}.canvas-hidden{position:fixed;left:-10000px;top:0;width:320px;height:320px}.preview{width:100%;height:900rpx;background:white;border:2rpx solid var(--line);border-radius:28rpx}.preview movable-view,.preview image{width:100%;height:100%}.crop{width:100%;background:var(--soft);border-radius:28rpx;overflow:hidden}.crop canvas{width:100%;height:100%}.search{margin:28rpx 0}.search .field{width:0}.filters{white-space:nowrap;margin-bottom:24rpx}.filters .chip{display:inline-block;margin-right:12rpx}.check{margin-top:24rpx;font-size:28rpx}.privacy-mask{position:fixed;inset:0;z-index:9999;background:rgba(117,28,53,.3);display:flex;align-items:center;padding:40rpx}.privacy-box{background:var(--surface);padding:36rpx;border-radius:var(--radius);width:100%}.ui-switch-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.ui-switch-label{font-size:30rpx;font-weight:600}.ui-switch-description{color:var(--body);font-size:24rpx;margin-top:6rpx}.ui-switch-row switch{flex-shrink:0}
