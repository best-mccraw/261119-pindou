.home{padding-bottom:calc(32rpx + env(safe-area-inset-bottom));overflow:hidden}.home-hero{position:relative;width:750rpx;height:800rpx;overflow:hidden;margin:0 auto}.home-art{position:absolute;width:750rpx;left:0;top:-132rpx}.home-actions{position:relative;padding:0 24rpx;margin-top:0}.home-entry{display:flex;align-items:center;text-align:left;width:100%;min-height:196rpx;background:linear-gradient(135deg,#FFFAF8,#FFF0F2);border:3rpx solid #fff;border-radius:56rpx;box-shadow:0 14rpx 28rpx rgba(185,112,130,.14);padding:28rpx 28rpx;margin:0 0 28rpx;gap:26rpx;line-height:1.4;color:var(--ink)}.cream-entry{background:linear-gradient(135deg,#FFFAF8,#FFF1DC)}.entry-copy{flex:1;min-width:0;border-left:3rpx solid #F8D8DF;padding-left:26rpx}.entry-title{font-size:42rpx;font-weight:700;white-space:nowrap}.entry-sub{font-size:27rpx;color:var(--body);margin-top:10rpx;white-space:nowrap}.entry-arrow{flex-shrink:0;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#F9B6C8,#F58FA7);color:white;border:2rpx solid white;border-radius:50%;width:66rpx;height:66rpx;font-size:42rpx}.entry-icon{position:relative;flex-shrink:0;width:106rpx;height:106rpx;transform:rotate(-9deg);border-radius:22rpx;background:#FFF1DC;border:10rpx solid #F9B6C8;box-shadow:0 8rpx 14rpx rgba(185,112,130,.17)}.photo-sun{position:absolute;right:12rpx;top:12rpx;width:22rpx;height:22rpx;border-radius:50%;background:#F9B6C8}.photo-mountain{position:absolute;width:46rpx;height:46rpx;background:#F58FA7;transform:rotate(45deg);left:15rpx;top:37rpx;border-radius:10rpx}.photo-icon{overflow:visible}.upload-badge{position:absolute;right:-22rpx;bottom:-18rpx;background:var(--brand);color:white;width:54rpx;height:54rpx;line-height:48rpx;text-align:center;border-radius:50%;border:4rpx solid white;font-size:40rpx;font-weight:700}.heart-icon{display:flex;align-items:center;justify-content:center;color:var(--brand);background:#FFFAF8;border-color:#FFF1DC;font-size:70rpx;text-shadow:0 3rpx 0 #D96883}.home-footer{display:flex;justify-content:center;align-items:center;gap:16rpx;font-size:25rpx;color:var(--body);margin:54rpx 18rpx 12rpx}.loose-bead{width:28rpx;height:30rpx;background:#F58FA7;border-radius:50%;border-top:8rpx solid #F9D6DF;box-shadow:0 6rpx 8rpx #F9D6DF;transform:rotate(-15deg)}.cream-bead{background:#F9D6DF;border-top-color:#FFF1DC;transform:rotate(12deg)}.entry-hover{opacity:.88}@media(max-width:350px){.entry-title{font-size:36rpx}.entry-sub{font-size:25rpx}.home-entry{gap:18rpx;padding:26rpx 20rpx}.entry-copy{padding-left:18rpx}.entry-arrow{width:56rpx;height:56rpx}}
