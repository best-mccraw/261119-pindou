<import src="../../templates/privacy.wxml"/>
<view class="page"><view class="title">找一张，开始拼</view><view class="sub">原创图案，标好每一颗的位置。</view><view class="row search"><input class="field" placeholder="搜索名称或关键词" value="{{q}}" data-key="q" bindinput="field" bindconfirm="search" confirm-type="search"/><button class="chip" bindtap="search">搜索</button></view><scroll-view scroll-x class="filters"><view wx:for="{{filters}}" wx:key="*this" class="chip {{filter==index?'active':''}}" data-i="{{index}}" bindtap="select">{{item}}</view></scroll-view><view wx:if="{{filter==5}}" class="section"><view class="row"><input class="field" type="number" maxlength="3" placeholder="宽（颗）" value="{{width}}" data-key="width" bindinput="field"/><text>×</text><input class="field" type="number" maxlength="3" placeholder="高（颗）" value="{{height}}" data-key="height" bindinput="field"/></view><button class="secondary" bindtap="search">应用尺寸筛选</button></view><view class="grid section"><view class="card" wx:for="{{items}}" wx:key="_id" data-id="{{item._id}}" bindtap="open"><image wx:if="{{!item.broken}}" src="{{item.cover}}" mode="aspectFit" lazy-load binderror="imageError" data-id="{{item._id}}"/><view wx:else class="status">封面未加载<br/>点击查看图纸</view><view class="cardbody"><view class="name">{{item.name}}</view><view class="hint">{{item.width}}×{{item.height}} 颗</view></view></view></view><view wx:if="{{loading}}" class="status">正在找图纸…</view><view wx:if="{{loaded && !items.length && !error}}" class="status">没有找到图纸，试试其他关键词或尺寸。</view><view wx:if="{{error}}" class="status">图纸暂时未加载，请检查网络。<button class="secondary" bindtap="retry">重新加载</button></view><button wx:if="{{next && !loading && !error}}" class="secondary" bindtap="more">加载更多</button><view wx:if="{{loaded && items.length && !next}}" class="status">已展示全部匹配图纸</view></view>

<template is="privacy" data="{{privacyVisible: privacyVisible}}"/>
