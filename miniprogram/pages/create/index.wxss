.create-page{padding-top:32rpx}.create-heading{text-align:center;font-size:33rpx;line-height:1.5;font-weight:600;margin:8rpx 0 34rpx;white-space:nowrap}.heading-heart{color:var(--rose);font-size:42rpx;vertical-align:middle}.upload-panel{border-radius:var(--radius);padding:16rpx;background:rgba(255,250,248,.76);box-shadow:var(--shadow)}.upload-border{border:2rpx dashed #F9B6C8;border-radius:38rpx;padding:66rpx 26rpx 36rpx;position:relative;overflow:hidden}.upload-picture{position:relative;width:154rpx;height:132rpx;border:10rpx solid #F58FA7;border-radius:26rpx;background:var(--surface);margin:10rpx auto 42rpx;box-shadow:0 0 0 8rpx white,0 14rpx 26rpx rgba(217,104,131,.16)}.picture-dot{position:absolute;left:20rpx;top:18rpx;width:25rpx;height:25rpx;background:#F9B6C8;border-radius:50%}.picture-hill{position:absolute;bottom:0;left:16rpx;width:90rpx;height:55rpx;background:linear-gradient(135deg,#F9B6C8,#F58FA7);clip-path:polygon(0 100%,35% 20%,55% 56%,75% 0,100% 100%)}.picture-plus{position:absolute;top:-45rpx;right:-42rpx;background:linear-gradient(145deg,#F9B6C8,#F58FA7);border:7rpx solid white;width:90rpx;height:90rpx;line-height:74rpx;text-align:center;border-radius:50%;color:white;font-size:70rpx;font-weight:300;box-shadow:0 10rpx 20rpx rgba(217,104,131,.12)}.upload-action{max-width:490rpx;margin:0 auto}.upload-caption{text-align:center;font-size:26rpx;color:var(--body);margin-top:20rpx}.flower{position:absolute;color:#F58FA7;text-shadow:0 4rpx 0 #F9D6DF;font-size:68rpx;line-height:1}.flower-top{right:28rpx;top:22rpx;transform:rotate(12deg)}.flower-bottom{left:16rpx;bottom:48rpx;transform:rotate(-16deg);font-size:60rpx}.parameter-heading{display:flex;gap:26rpx;align-items:center;margin:0 0 28rpx}.parameter-heart{font-size:60rpx;color:var(--brand);border-right:2rpx solid #F9B6C8;padding-right:24rpx;text-shadow:0 4rpx 0 #F9D6DF;line-height:1.1}.parameter-title{font-size:38rpx;font-weight:700}.size-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.small-size{margin-top:16rpx;width:100%}.dimension-row{margin-top:24rpx;padding:22rpx 18rpx;background:var(--soft);border-radius:28rpx;display:flex;gap:10rpx;align-items:center;font-size:27rpx;white-space:nowrap}.dimension-row ui-input{flex:1;min-width:0}.times{padding:0 8rpx}.size-hint{font-size:22rpx;line-height:1.6;color:var(--body);margin-top:14rpx}.parameter-divider{height:2rpx;background:var(--line);margin:26rpx 0}.generate-action{margin:36rpx 20rpx 0}.ad-hint,.disclaimer{text-align:center;font-size:22rpx;line-height:1.6;color:var(--body);padding:0 16rpx;margin-top:18rpx}.disclaimer{margin-top:8rpx}.new-round{margin-top:24rpx}.create-footer{text-align:center;font-size:26rpx;color:var(--body);margin:34rpx 0 10rpx}.crop-tools{margin-top:14rpx}@media(max-width:350px){.create-heading{font-size:29rpx}.dimension-row{gap:6rpx;padding:18rpx 12rpx;font-size:25rpx}.times{padding:0 2rpx}}
