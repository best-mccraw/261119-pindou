page{background:#FAFBF8;color:#153F36;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:32rpx;line-height:1.55}view,input,button{box-sizing:border-box}.page{padding:40rpx 32rpx calc(48rpx + env(safe-area-inset-bottom))}.title{font-size:52rpx;font-weight:700;letter-spacing:2rpx;margin-bottom:12rpx}.sub,.hint{color:#64746D;font-size:26rpx}.section{margin-top:40rpx}.label{font-size:34rpx;font-weight:600;margin-bottom:18rpx}.primary{background:#237C66;color:white;border-radius:16rpx;font-size:32rpx;min-height:96rpx;margin-top:28rpx}.secondary{background:#E8F1EB;color:#153F36;border-radius:14rpx;font-size:28rpx;min-height:88rpx;margin-top:20rpx}button::after{border:0}button[disabled]{opacity:.5}.row{display:flex;gap:16rpx;align-items:center}.wrap{flex-wrap:wrap}.chip{padding:18rpx 24rpx;background:#E8F1EB;border:2rpx solid transparent;border-radius:12rpx;font-size:28rpx;white-space:nowrap}.active{border-color:#237C66;background:#D8EBE0}.field{height:92rpx;min-width:0;background:white;border:2rpx solid #D5DED7;border-radius:12rpx;padding:16rpx;flex:1;color:#153F36}.notice{padding:24rpx;background:#E8F1EB;border-radius:12rpx;margin-top:24rpx;font-size:26rpx}.error{color:#9B3B35}.grid{display:grid;grid-template-columns:1fr 1fr;gap:24rpx}.card{overflow:hidden;background:white;border:2rpx solid #D5DED7;border-radius:18rpx}.card image{width:100%;height:300rpx;display:block}.cardbody{padding:18rpx}.name{font-weight:600}.swatch{width:36rpx;height:36rpx;border:1px solid #D5DED7;border-radius:6rpx;display:inline-block;vertical-align:middle;margin-right:12rpx}.count{padding:12rpx 0;border-bottom:1px solid #E8F1EB;font-size:28rpx}.status{text-align:center;padding:36rpx 12rpx;color:#64746D}.canvas-hidden{position:fixed;left:-10000px;top:0;width:320px;height:320px}.preview{width:100%;height:900rpx;background:white;border:2rpx solid #D5DED7;border-radius:12rpx}.preview movable-view{width:100%;height:100%}.preview image{width:100%;height:100%}.crop{width:100%;height:600rpx;background:#E8F1EB;border-radius:12rpx;overflow:hidden}.crop canvas{width:100%;height:100%}.fine{font-size:24rpx;color:#64746D;margin-top:16rpx}.hero{margin-top:32rpx;background:#E8F1EB;padding:36rpx;border-radius:24rpx}.hero image{width:100%;height:340rpx;image-rendering:pixelated}.search{margin:28rpx 0}.filters{white-space:nowrap;margin-bottom:24rpx}.filters .chip{display:inline-block;margin-right:12rpx}.check{margin-top:24rpx;font-size:28rpx}

.privacy-mask{position:fixed;inset:0;z-index:9999;background:rgba(21,63,54,.45);display:flex;align-items:center;padding:40rpx}.privacy-box{background:#FAFBF8;padding:36rpx;border-radius:20rpx;width:100%}
